# Postgres 18 con pgvector. Puerto 5433 para no chocar con Radar de Pliegos.
   POSTGRES_USER=
   POSTGRES_PASSWORD=
   POSTGRES_DB=lcsp
   LCSP_DB_PORT=5433

   # Conexión desde el host (uv run ... en /backend). Dentro de Compose se fuerza db:5432.
   DATABASE_URL=
   DATABASE_URL_TEST=

   # Puertos del host
   API_PORT=8001
   WEB_PORT=8080

   # NaN Builders (nunca commitear la clave real)
   NAN_API_KEY=
   NAN_BASE_URL=https://api.nan.builders/v1
   NAN_CHAT_MODEL=deepseek-v4-flash
   NAN_EMBEDDING_MODEL=qwen3-embedding
   NAN_RERANK_MODEL=rerank

   # Recuperación
   EMBEDDING_DIMENSIONS=4096
   EMBEDDING_BATCH_SIZE=16
   RETRIEVAL_TOP_K=6
   RERANK_THRESHOLD=0.85

   CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]